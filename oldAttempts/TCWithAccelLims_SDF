import numpy as np
import heapq
from scipy.optimize import minimize
from scipy.ndimage import distance_transform_edt
import plotly.graph_objects as go
from plotly.subplots import make_subplots

# -----------------------------
# Environment and risk generation
# -----------------------------
def create_3d_environment(nx=40, ny=40, nz=20, res=1.0):
    occ = np.zeros((nz, ny, nx), dtype=bool)
    risk = np.zeros((nz, ny, nx), dtype=np.float32)

    xs = np.arange(nx) * res
    ys = np.arange(ny) * res
    zs = np.arange(nz) * res
    X, Y = np.meshgrid(xs, ys, indexing='xy')

    cx, cy = xs[nx // 2], ys[ny // 2]
    sigma = max(nx, ny) * res / 6.0
    base_risk_2d = np.exp(-((X - cx) ** 2 + (Y - cy) ** 2) / (2 * sigma ** 2))

    beta = 0.12
    fz = np.exp(-beta * zs)
    alpha = 2.0
    for k in range(nz):
        risk[k, :, :] = base_risk_2d * (1.0 + alpha * fz[k])
    risk /= (risk.max() + 1e-12)

    col_radius = nx // 8
    for k in range(nz):
        for j in range(ny):
            for i in range(nx):
                dx = i - nx // 2
                dy = j - ny // 2
                if dx * dx + dy * dy <= col_radius * col_radius and k < nz // 2:
                    occ[k, j, i] = True

    wall_x = nx // 3
    for k in range(nz // 2):
        for j in range(ny // 3, 2 * ny // 3):
            occ[k, j, wall_x] = True

    return occ, risk, res

# -----------------------------
# Signed Distance Field
# -----------------------------
def compute_sdf(occ, res=1.0):
    occ_bool = occ.astype(bool)
    dist_out = distance_transform_edt(~occ_bool) * res
    dist_in = distance_transform_edt(occ_bool) * res
    sdf = dist_out - dist_in
    return sdf

# -----------------------------
# A* coarse planner
# -----------------------------
def neighbors_3d():
    nbrs = []
    for dz in [-1, 0, 1]:
        for dy in [-1, 0, 1]:
            for dx in [-1, 0, 1]:
                if dx == 0 and dy == 0 and dz == 0:
                    continue
                move_cost = np.sqrt(dx * dx + dy * dy + dz * dz)
                nbrs.append((dx, dy, dz, move_cost))
    return nbrs

def idx_from_xyz(x, y, z, nx, ny, nz):
    return x + nx * (y + ny * z)

def xyz_from_idx(idx, nx, ny, nz):
    z = idx // (nx * ny)
    rem = idx % (nx * ny)
    y = rem // nx
    x = rem % nx
    return x, y, z

def astar_3d(start, goal, occ, risk, w_risk=5.0, base_cost=1.0):
    nz, ny, nx = occ.shape
    nbrs = neighbors_3d()

    start_idx = idx_from_xyz(*start, nx, ny, nz)
    goal_idx = idx_from_xyz(*goal, nx, ny, nz)

    g = np.full(nx * ny * nz, np.inf, dtype=np.float32)
    parent = np.full(nx * ny * nz, -1, dtype=np.int32)

    def heuristic(x, y, z):
        gx, gy, gz = goal
        return base_cost * np.sqrt((x - gx) ** 2 + (y - gy) ** 2 + (z - gz) ** 2)

    open_heap = []
    g[start_idx] = 0.0
    heapq.heappush(open_heap, (heuristic(*start), start_idx))
    in_open = np.zeros(nx * ny * nz, dtype=bool)
    in_open[start_idx] = True

    while open_heap:
        f_curr, curr_idx = heapq.heappop(open_heap)
        in_open[curr_idx] = False

        if curr_idx == goal_idx:
            path = []
            idx = curr_idx
            while idx != -1:
                x, y, z = xyz_from_idx(idx, nx, ny, nz)
                path.append((x, y, z))
                idx = parent[idx]
            path.reverse()
            return path

        cx, cy, cz = xyz_from_idx(curr_idx, nx, ny, nz)

        for dx, dy, dz, move_cost in nbrs:
            nx_ = cx + dx
            ny_ = cy + dy
            nz_ = cz + dz

            if nx_ < 0 or nx_ >= nx or ny_ < 0 or ny_ >= ny or nz_ < 0 or nz_ >= nz:
                continue
            if occ[nz_, ny_, nx_]:
                continue

            n_idx = idx_from_xyz(nx_, ny_, nz_, nx, ny, nz)
            step_cost = base_cost * move_cost + w_risk * risk[nz_, ny_, nx_]
            tentative_g = g[curr_idx] + step_cost

            if tentative_g < g[n_idx]:
                g[n_idx] = tentative_g
                parent[n_idx] = curr_idx
                f_n = tentative_g + heuristic(nx_, ny, nz_)
                if not in_open[n_idx]:
                    heapq.heappush(open_heap, (f_n, n_idx))
                    in_open[n_idx] = True

    return None

# -----------------------------
# Utilities
# -----------------------------
def resample_path(path_voxels, num_nodes):
    pts = np.array(path_voxels, dtype=float)
    diffs = np.linalg.norm(np.diff(pts, axis=0), axis=1)
    cum = np.concatenate(([0.0], np.cumsum(diffs)))
    if cum[-1] == 0:
        return np.repeat(pts[:1], num_nodes, axis=0)
    t = np.linspace(0, cum[-1], num_nodes)
    resampled = np.zeros((num_nodes, 3), dtype=float)
    for i in range(3):
        resampled[:, i] = np.interp(t, cum, pts[:, i])
    return resampled

def trilinear_interpolate(field, p):
    nz, ny, nx = field.shape
    x, y, z = p
    x = np.clip(x, 0, nx - 1 - 1e-6)
    y = np.clip(y, 0, ny - 1 - 1e-6)
    z = np.clip(z, 0, nz - 1 - 1e-6)

    x0 = int(np.floor(x)); x1 = x0 + 1
    y0 = int(np.floor(y)); y1 = y0 + 1
    z0 = int(np.floor(z)); z1 = z0 + 1

    xd = x - x0; yd = y - y0; zd = z - z0

    c000 = field[z0, y0, x0]
    c100 = field[z0, y0, x1]
    c010 = field[z0, y1, x0]
    c110 = field[z0, y1, x1]
    c001 = field[z1, y0, x0]
    c101 = field[z1, y0, x1]
    c011 = field[z1, y1, x0]
    c111 = field[z1, y1, x1]

    c00 = c000 * (1 - xd) + c100 * xd
    c01 = c001 * (1 - xd) + c101 * xd
    c10 = c010 * (1 - xd) + c110 * xd
    c11 = c011 * (1 - xd) + c111 * xd

    c0 = c00 * (1 - yd) + c10 * yd
    c1 = c01 * (1 - yd) + c11 * yd

    c = c0 * (1 - zd) + c1 * zd
    return float(c)

# -----------------------------
# Build optimization problem with energy and ground proximity
# -----------------------------
def build_trajectory_problem_with_energy_and_sdf(risk_field, sdf_field, dt=1.0,
                                                 w_acc=1.0, w_len=0.05, w_risk=6.0,
                                                 w_ground=8.0, ground_scale=1.0,
                                                 w_work=10.0, a_max=1.0, v_max=5.0, d_min=0.5):
    """
    Objective includes:
      - acceleration effort (sum ||a||^2)
      - path length
      - risk
      - ground proximity penalty: penalize low altitude via g(z) = exp(-gamma*z)
      - propulsive work penalty: penalize positive mechanical work a·v when >0
    """

    nz, ny, nx = risk_field.shape

    def unpack_vars(x_flat):
        interior = x_flat.reshape((-1, 6))
        return interior[:, :3], interior[:, 3:6]

    def objective(x_flat, start, goal, N):
        interior_p, interior_v = unpack_vars(x_flat)
        X = np.zeros((N, 3), dtype=float)
        V = np.zeros((N, 3), dtype=float)
        X[0] = start['pos']; X[-1] = goal['pos']
        V[0] = start['vel']; V[-1] = goal['vel']
        X[1:-1] = interior_p
        V[1:-1] = interior_v

        # accelerations
        A = (V[1:] - V[:-1]) / dt  # shape (N-1,3)
        acc_cost = np.sum(np.sum(A ** 2, axis=1))

        # length cost
        segs = np.linalg.norm(np.diff(X, axis=0), axis=1)
        len_cost = np.sum(segs)

        # risk cost
        risk_cost = 0.0
        for k in range(N):
            p = X[k]
            p_clamped = np.clip(p, [0, 0, 0], [nx - 1 - 1e-6, ny - 1 - 1e-6, nz - 1 - 1e-6])
            risk_cost += trilinear_interpolate(risk_field, p_clamped)

        # ground proximity penalty: penalize being close to ground (z small)
        # use g(z) = exp(-gamma * z_vox) scaled by ground_scale
        gamma = 0.6  # controls how quickly penalty decays with altitude
        z_vals = X[:, 2]
        ground_pen = np.sum(np.exp(-gamma * z_vals) * ground_scale)

        # propulsive work penalty: approximate positive mechanical work
        # work_k ~ max(0, a_k dot v_mid) * dt, where v_mid = 0.5*(v_k + v_{k+1})
        work = 0.0
        for k in range(A.shape[0]):
            a_k = A[k]
            v_mid = 0.5 * (V[k] + V[k + 1])
            dot = np.dot(a_k, v_mid)
            pos_dot = 0.5 * (dot + np.abs(dot))  # positive part
            work += pos_dot * dt
        # square or linear penalty; use linear here to approximate energy input
        work_cost = work

        J = w_acc * acc_cost + w_len * len_cost + w_risk * risk_cost + w_ground * ground_pen + w_work * work_cost
        return J

    def dynamics_eq_constraints(x_flat, start, goal, N):
        interior_p, interior_v = unpack_vars(x_flat)
        X = np.zeros((N, 3), dtype=float)
        V = np.zeros((N, 3), dtype=float)
        X[0] = start['pos']; X[-1] = goal['pos']
        V[0] = start['vel']; V[-1] = goal['vel']
        X[1:-1] = interior_p
        V[1:-1] = interior_v

        res = []
        for k in range(N - 1):
            lhs = X[k + 1] - X[k] - 0.5 * (V[k] + V[k + 1]) * dt
            res.append(lhs)
        res = np.concatenate(res)
        return res

    def accel_ineq_constraints(x_flat, start, goal, N):
        interior_p, interior_v = unpack_vars(x_flat)
        V = np.zeros((N, 3), dtype=float)
        V[0] = start['vel']; V[-1] = goal['vel']
        V[1:-1] = interior_v

        vals = []
        for k in range(N - 1):
            a_k = (V[k + 1] - V[k]) / dt
            vals.append(a_max - np.linalg.norm(a_k))  # >=0 when satisfied
        return np.array(vals)

    def sdf_ineq_constraints(x_flat, start, goal, N):
        interior_p, interior_v = unpack_vars(x_flat)
        X = np.zeros((N, 3), dtype=float)
        X[0] = start['pos']; X[-1] = goal['pos']
        X[1:-1] = interior_p

        vals = []
        for k in range(N):
            p = X[k]
            p_clamped = np.clip(p, [0, 0, 0], [nx - 1 - 1e-6, ny - 1 - 1e-6, nz - 1 - 1e-6])
            d = trilinear_interpolate(sdf_field, p_clamped)
            vals.append(d - d_min)
        return np.array(vals)

    def bounds_for_interior(N, v_max_local):
        n_interior = N - 2
        lower = []
        upper = []
        for _ in range(n_interior):
            lower.extend([0.0, 0.0, 0.0])
            upper.extend([nx - 1 - 1e-6, ny - 1 - 1e-6, nz - 1 - 1e-6])
            lower.extend([-v_max_local, -v_max_local, -v_max_local])
            upper.extend([v_max_local, v_max_local, v_max_local])
        return np.array(lower), np.array(upper)

    return objective, dynamics_eq_constraints, accel_ineq_constraints, sdf_ineq_constraints, bounds_for_interior

# -----------------------------
# Plotly panel with initial A* overlay
# -----------------------------
def plot_panel_with_initial(occ, risk, coarse_path, X_opt, V_opt, res=1.0, title="Trajectory with Profiles"):
    nz, ny, nx = occ.shape
    xs = np.arange(nx) * res
    ys = np.arange(ny) * res
    zs = np.arange(nz) * res

    occ_indices = np.argwhere(occ)
    ox = occ_indices[:, 2] * res if occ_indices.size > 0 else np.array([])
    oy = occ_indices[:, 1] * res if occ_indices.size > 0 else np.array([])
    oz = occ_indices[:, 0] * res if occ_indices.size > 0 else np.array([])

    Xg = np.repeat(xs[np.newaxis, np.newaxis, :], ny, axis=1).repeat(nz, axis=0).flatten()
    Yg = np.repeat(ys[np.newaxis, :, np.newaxis], nx, axis=2).repeat(nz, axis=0).flatten()
    Zg = np.repeat(zs[:, np.newaxis, np.newaxis], ny, axis=1).repeat(nx, axis=2).flatten()

    fig = make_subplots(rows=2, cols=2,
                        specs=[[{"type": "scene", "rowspan": 2}, {"type": "xy"}],
                               [None, {"type": "xy"}]],
                        subplot_titles=(title, "Velocity profile", "Acceleration magnitude"))

    # 3D scene: risk volume
    fig.add_trace(go.Volume(x=Xg, y=Yg, z=Zg, value=risk.flatten(),
                            isomin=0.05, isomax=1.0, opacity=0.12, surface_count=12,
                            colorscale='YlOrRd', name='Risk'), row=1, col=1)
    if occ_indices.size > 0:
        fig.add_trace(go.Scatter3d(x=ox, y=oy, z=oz, mode='markers',
                                   marker=dict(size=3, color='black'), name='Obstacles'), row=1, col=1)

    # initial coarse A* path overlay (dashed red)
    if coarse_path is not None:
        cp = np.array(coarse_path)
        cpx = cp[:, 0] * res; cpy = cp[:, 1] * res; cpz = cp[:, 2] * res
        fig.add_trace(go.Scatter3d(x=cpx, y=cpy, z=cpz, mode='lines+markers',
                                   line=dict(color='red', width=3, dash='dash'),
                                   marker=dict(size=2, color='red'),
                                   name='A* coarse path'), row=1, col=1)

    # optimized path (blue)
    px = X_opt[:, 0] * res; py = X_opt[:, 1] * res; pz = X_opt[:, 2] * res
    fig.add_trace(go.Scatter3d(x=px, y=py, z=pz, mode='lines+markers',
                               line=dict(color='blue', width=5), marker=dict(size=4, color='blue'),
                               name='Optimized Path'), row=1, col=1)

    # Velocity profile
    t = np.arange(X_opt.shape[0])
    fig.add_trace(go.Scatter(x=t, y=V_opt[:, 0], mode='lines+markers', name='vx'), row=1, col=2)
    fig.add_trace(go.Scatter(x=t, y=V_opt[:, 1], mode='lines+markers', name='vy'), row=1, col=2)
    fig.add_trace(go.Scatter(x=t, y=V_opt[:, 2], mode='lines+markers', name='vz'), row=1, col=2)
    fig.update_xaxes(title_text="node index", row=1, col=2)
    fig.update_yaxes(title_text="velocity (vox/s)", row=1, col=2)

    # Acceleration magnitude
    accs = np.linalg.norm(np.diff(V_opt, axis=0), axis=1)
    t_acc = np.arange(accs.shape[0])
    fig.add_trace(go.Bar(x=t_acc, y=accs, name='|a|'), row=2, col=2)
    fig.update_xaxes(title_text="interval index", row=2, col=2)
    fig.update_yaxes(title_text="acc magnitude (vox/s^2)", row=2, col=2)

    fig.update_layout(scene=dict(xaxis_title='X (m)', yaxis_title='Y (m)', zaxis_title='Z (m)', aspectmode='data'),
                      height=900, width=1200)
    fig.show()

# -----------------------------
# Demo
# -----------------------------
def demo_energy_and_sdf():
    occ, risk, res = create_3d_environment(nx=40, ny=40, nz=20, res=1.0)
    sdf = compute_sdf(occ, res=res)

    start_pos = np.array([5.0, 5.0, 15.0])
    goal_pos = np.array([35.0, 35.0, 0.0])

    start_vox = (int(start_pos[0]), int(start_pos[1]), int(start_pos[2]))
    goal_vox = (int(goal_pos[0]), int(goal_pos[1]), int(goal_pos[2]))
    coarse_path = astar_3d(start_vox, goal_vox, occ, risk, w_risk=8.0, base_cost=1.0)
    if coarse_path is None:
        print("No coarse path found.")
        return
    print("Coarse path length (voxels):", len(coarse_path))

    N = 30
    X0 = resample_path(coarse_path, N)
    V0 = np.zeros_like(X0)
    diffs = np.diff(X0, axis=0)
    V0[1:-1] = (diffs[:-1] + diffs[1:]) / 2.0
    V0[0] = np.zeros(3); V0[-1] = np.zeros(3)

    dt = 1.0
    w_acc = 1.5
    w_len = 0.5
    w_risk = 6.0
    w_ground = 1.0      # weight for ground proximity penalty
    ground_scale = 1.0   # scale factor inside exp
    w_work = 5.0        # weight for propulsive work penalty
    a_max = 1.2
    v_max = 4.0
    d_min = 1.5

    objective, dyn_eq, accel_ineq, sdf_ineq, bounds_fn = build_trajectory_problem_with_energy_and_sdf(
        risk, sdf, dt=dt, w_acc=w_acc, w_len=w_len, w_risk=w_risk,
        w_ground=w_ground, ground_scale=ground_scale, w_work=w_work,
        a_max=a_max, v_max=v_max, d_min=d_min
    )

    x0_flat = np.hstack([X0[1:-1].ravel(), V0[1:-1].ravel()])
    start = {'pos': start_pos, 'vel': np.zeros(3)}
    goal = {'pos': goal_pos, 'vel': np.zeros(3)}
    lower, upper = bounds_fn(N, v_max)
    bounds = [(float(lower[i]), float(upper[i])) for i in range(len(lower))]

    dyn_cons = {'type': 'eq', 'fun': lambda x: dyn_eq(x, start, goal, N)}
    accel_cons = {'type': 'ineq', 'fun': lambda x: accel_ineq(x, start, goal, N)}
    sdf_cons = {'type': 'ineq', 'fun': lambda x: sdf_ineq(x, start, goal, N)}

    print("Starting constrained optimization (SLSQP) with energy and SDF constraints...")
    res_opt = minimize(lambda x: objective(x, start, goal, N),
                       x0_flat,
                       method='SLSQP',
                       bounds=bounds,
                       constraints=[dyn_cons, accel_cons, sdf_cons],
                       options={'maxiter': 800, 'ftol': 1e-6, 'disp': True})

    if not res_opt.success:
        print("Optimization warning:", res_opt.message)

    interior = res_opt.x.reshape((-1, 6))
    X_opt = np.zeros((N, 3), dtype=float)
    V_opt = np.zeros((N, 3), dtype=float)
    X_opt[0] = start['pos']; X_opt[-1] = goal['pos']
    V_opt[0] = start['vel']; V_opt[-1] = goal['vel']
    X_opt[1:-1] = interior[:, :3]
    V_opt[1:-1] = interior[:, 3:6]

    segs_before = np.linalg.norm(np.diff(X0, axis=0), axis=1)
    segs_after = np.linalg.norm(np.diff(X_opt, axis=0), axis=1)
    len_before = segs_before.sum()
    len_after = segs_after.sum()
    risk_before = sum(trilinear_interpolate(risk, p) for p in X0)
    risk_after = sum(trilinear_interpolate(risk, p) for p in X_opt)
    accs = np.linalg.norm((V_opt[1:] - V_opt[:-1]) / dt, axis=1)
    max_acc = accs.max()
    min_sdf = min(trilinear_interpolate(sdf, p) for p in X_opt)

    # compute approximate propulsive work for reporting
    A = (V_opt[1:] - V_opt[:-1]) / dt
    work = 0.0
    for k in range(A.shape[0]):
        a_k = A[k]
        v_mid = 0.5 * (V_opt[k] + V_opt[k + 1])
        dot = np.dot(a_k, v_mid)
        pos_dot = 0.5 * (dot + np.abs(dot))
        work += pos_dot * dt

    print(f"Length before: {len_before:.3f}, after: {len_after:.3f}")
    print(f"Risk before: {risk_before:.3f}, after: {risk_after:.3f}")
    print(f"Max acceleration after optimization: {max_acc:.3f} (limit {a_max})")
    print(f"Minimum SDF along trajectory: {min_sdf:.3f} (clearance limit {d_min})")
    print(f"Approximate propulsive work after optimization: {work:.3f} (lower is better)")

    plot_panel_with_initial(occ, risk, coarse_path, X_opt, V_opt, res=res, title="Optimized Trajectory with Energy Model and SDF")

if __name__ == "__main__":
    demo_energy_and_sdf()
